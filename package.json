{
  "name": "sorcery-collection-manager",
  "version": "0.1.0",
  "description": "Visual deck-building tool for Sorcery TCG",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node -e \"const fs=require('fs');if(fs.existsSync('dist'))fs.rmSync('dist',{recursive:true,force:true,maxRetries:3,retryDelay:100})\" && tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "cards:thumbs": "node scripts/generate-card-thumbs.mjs",
    "cards:thumbs:force": "node scripts/generate-card-thumbs.mjs --force",
    "cards:atlas": "node scripts/generate-card-thumb-atlases.mjs",
    "cards:atlas:medium": "node scripts/generate-card-thumb-atlases.mjs --input public/assets/Cards --output public/assets/CardsMediumAtlas --card-width 380 --card-height 531 --atlas-min 16 --atlas-max 24 --quality 68 --effort 4",
    "cards:thumbs+atlas": "pnpm cards:thumbs && pnpm cards:atlas",
    "cards:atlas:all": "pnpm cards:atlas && pnpm cards:atlas:medium",
    "publish": "pnpm build && netlify deploy --prod --no-build --dir=dist --functions=netlify/functions"
  },
  "dependencies": {
    "@netlify/blobs": "^10.7.0",
    "@netlify/functions": "^5.1.2",
    "idb-keyval": "^6.2.1",
    "pixi-viewport": "^6.0.3",
    "pixi.js": "^8.6.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^25.0.8",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "netlify-cli": "^23.15.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.0.7"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
