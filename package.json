{
  "name": "sorcery-collection-manager",
  "version": "0.1.0",
  "description": "Visual deck-building tool for Sorcery TCG",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node -e \"const fs=require('fs');if(fs.existsSync('dist'))fs.rmSync('dist',{recursive:true,force:true,maxRetries:3,retryDelay:100})\" && tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:ventraip": "bash scripts/build-ventraip.sh",
    "deploy:staging": "bash scripts/deploy-staging.sh",
    "promote:production": "bash scripts/promote-production.sh",
    "cards:thumbs": "node scripts/generate-card-thumbs.mjs",
    "cards:thumbs:force": "node scripts/generate-card-thumbs.mjs --force",
    "cards:atlas": "node scripts/generate-card-thumb-atlases.mjs --input public/assets/Cards --output public/assets/CardsThumbAtlas --card-width 92 --card-height 128 --atlas-width 1024 --atlas-height 1024 --quality 58 --effort 4",
    "cards:atlas:medium": "node scripts/generate-card-thumb-atlases.mjs --input public/assets/Cards --output public/assets/CardsMediumAtlas --card-width 275 --card-height 384 --atlas-width 1112 --atlas-height 1160 --quality 64 --effort 4",
    "cards:thumbs+atlas": "pnpm cards:thumbs && pnpm cards:atlas:all",
    "cards:atlas:all": "pnpm cards:atlas && pnpm cards:atlas:medium",
    "curiosa:decks": "node scripts/fetch-curiosa-decks.mjs",
    "curiosa:search-decks": "node scripts/search-curiosa-decks.mjs",
    "associations:build": "node scripts/build-card-associations.mjs"
  },
  "dependencies": {
    "idb-keyval": "^6.2.1",
    "pixi-viewport": "^6.0.3",
    "pixi.js": "^8.6.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^25.0.8",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "jsdom": "^29.1.1",
    "sharp": "^0.34.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.0.7",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
