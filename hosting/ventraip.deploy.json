      "**/ehthumbs.db",
      "Desktop.ini",
      "**/Desktop.ini",
      ".apdisk",
      "**/.apdisk",
      "__MACOSX/**",
      "__MACOSX/",
      "**/__MACOSX/**",
      "**/__MACOSX/",
      ".Spotlight-V100/**",
      ".Spotlight-V100/",
      "**/.Spotlight-V100/**",
      "**/.Spotlight-V100/",
      ".Trashes/**",
      ".Trashes/",
      "**/.Trashes/**",
      "**/.Trashes/",
