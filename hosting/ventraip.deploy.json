{
  "protocol": "explicit-ftps",
  "host": "s04dd.syd6.hostingplatform.net.au",
  "port": 21,
  "targets": {
    "staging": {
      "host": "s04dd.syd6.hostingplatform.net.au",
      "port": 21,
      "username": "sorcerydeploy@sorcerystacks.com",
      "remoteDir": "/",
      "domain": "https://staging.sorcerystacks.com",
      "stageSubdir": "staging"
    },
    "production": {
      "host": "s04dd.syd6.hostingplatform.net.au",
      "port": 21,
      "username": "Manager@sorcerystacks.com",
      "remoteDir": "/",
      "domain": "https://sorcerystacks.com",
      "stageSubdir": "production",
      "confirmation": "sorcerystacks.com"
    }
  },
  "excludes": {
    "common": [
